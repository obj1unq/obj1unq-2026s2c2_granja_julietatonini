import wollok.game.*
import personaje.*
import cultivos.*



// EL ORIGINAL: 
program lagranja {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("fondo.png")

 	game.addVisualCharacter(personaje)
 	

 	//  COMIENZA
	game.start()
}




// MODIFICADO POR MI: 

program lagranja {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("fondo.png")

 	game.addVisualCharacter(personaje)
 	
	keyboard.g().onPressDo({personaje.cambiarGenero()})
	keyboard.m().onPressDo({personaje.plantar(maiz)})
	keyboard.t().onPressDo({personaje.plantar(trigo)})
	keyboard.o().onPressDo({personaje.plantar(tomaco)})
	keyboard.r().onPressDo({personaje.regar()})
	keyboard.c().onPressDo({personaje.cosechar()})
	


 	//  COMIENZA
	game.start()
}