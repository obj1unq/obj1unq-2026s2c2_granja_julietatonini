import wollok.game.*
import granja.*


describe "test de la granja" {


    test "personaje femenino mirando al frente" {
        personaje.genero(femenino)
        assert.equals("f-player-normal.png", personaje.image())
    }


    test "personaje femenino mirando hacia abajo" {
        personaje.genero(femenino)
        game.addVisual(objetoDePrueba)
        assert.equals("f-player-abajo.png", personaje.image())
    }


    test "personaje masculino mirando al frente" {
        personaje.genero(masculino)
        assert.equals("m-player-normal.png", personaje.image())
    }


    test "personaje masculino mirando hacia abajo" {
        personaje.genero(masculino)
        game.addVisual(objetoDePrueba)
        assert.equals("m-player-abajo.png", personaje.image())
    }


    test "cambio de genero"{
        personaje.genero(femenino)
        personaje.cambiarGenero()
        assert.equals(masculino, personaje.genero())
    }



    test "sembrar tomate en esta posicion"{
        personaje.position(game.at(5,5))
        personaje.plantar(tomaco)
        assert.equals(5, tomaco.position().x())
        assert.equals(5, tomaco.position().y())
    }


    test "es el unico cultivo"{
        personaje.position(game.at(5,5))
        personaje.plantar(tomaco)
        assert.equals(#{tomaco}, granja.cultivos())
    }


    test "el personaje no puede plantar"{
        personaje.position(game.at(5,5))
        personaje.plantar(tomaco)
        assert.throwsException({personaje.plantar(trigo)})
    }



    test "el personaje no puede plantar dos veces lo mismo"{
        personaje.position(game.at(5,5))
        personaje.plantar(tomaco)
        personaje.position(game.at(6,6))
        assert.throwsException({personaje.plantar(tomaco)})
    }


    test "el personaje agrega a sus plantaciones trigo"{
        personaje.position(game.at(5,5))
        personaje.plantar(tomaco)
        personaje.position(game.at(6,6))
        personaje.plantar(trigo)
        assert.equals(6, trigo.position().x())
        assert.equals(6, trigo.position().y())
        assert.equals(#{tomaco, trigo}, granja.cultivos())
    }



    test "sin cultivo no se puede regar"{
        assert.throwsException({personaje.regar()})
    }



    test "maiz"{
        personaje.plantar(maiz)
        assert.equals("maiz_bebe.png", maiz.image())
        personaje.regar()
        assert.equals("maiz_adulto.png", maiz.image())
        personaje.regar()
        assert.equals("maiz_adulto.png", maiz.image())
    }



    test "trigo"{
        personaje.plantar(trigo)
        assert.equals("trigo_0.png", trigo.image())
        personaje.regar()
        assert.equals("trigo_1.png", trigo.image())
        personaje.regar()
        assert.equals("trigo_2.png", trigo.image())
        personaje.regar()
        assert.equals("trigo_3.png", trigo.image())
        personaje.regar()
        assert.equals("trigo_0.png", trigo.image())
    }



    test "tomaco"{
        game.height(5)
        game.width(5)
        personaje.position(game.at(3,3))
        personaje.plantar(tomaco)
        personaje.regar()
        assert.equals(3, tomaco.position().x())
        assert.equals(4, tomaco.position().y())
        personaje.position(game.at(3,4))
        personaje.regar()
        assert.equals(3, tomaco.position().x())
        assert.equals(0, tomaco.position().y())
        personaje.position(game.at(3,1))
        personaje.plantar(trigo)
        personaje.position(game.at(3,0))
        personaje.regar()
        assert.equals(3, tomaco.position().x())
        assert.equals(0, tomaco.position().y())
    }

}

